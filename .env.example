# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# The scraper service (lead-gen-campaign-tally-scraper, `npm run serve`).
# Whether this is reachable is what decides if this instance can start scrapes,
# so a hosted deployment can leave it as-is and will correctly be read-only.
SCRAPER_URL=http://127.0.0.1:3900

# Postgres connection string, the same database the scraper service writes to.
# This app only reads from it. Without it, every data screen shows a setup notice.
DATABASE_URL=
