# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.

# Set to 1 only on the machine that has Chrome signed in to Instagram/Facebook
# with the mcp-chrome extension connected. Its ABSENCE is what makes a hosted
# deployment read-only, so leave it unset there.
SCRAPER_ENABLED=1

# Neon (or any Postgres) connection string. Required for web-driven scrapes,
# which write straight to the database and keep no local copies.
# Get it from the Neon dashboard, then run: npm run db:migrate
DATABASE_URL=

# Direct (non-pooled) connection, used only by the migration script.
# Optional — falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Path to a checkout of lead-gen-campaign-tally-scraper.
# Defaults to ../lead-gen-campaign-tally-scraper, i.e. the two repos cloned
# side by side. Only needed if yours lives somewhere else.
SCRAPER_DIR=../lead-gen-campaign-tally-scraper

# Where the mcp-chrome bridge listens. Rarely needs changing.
MCP_ENDPOINT=http://127.0.0.1:12306/mcp
